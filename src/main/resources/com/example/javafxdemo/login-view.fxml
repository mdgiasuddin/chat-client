<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12.0" prefWidth="360" prefHeight="280"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javafxdemo.chat.LoginController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <Label text="Chat Login" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="70"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Host:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="hostField" text="localhost"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Port:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="portField" text="5555"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="usernameField" promptText="Enter your username"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Button fx:id="loginButton" text="Login" defaultButton="true"
            onAction="#onLogin"/>

    <Label fx:id="statusLabel" wrapText="true"
           style="-fx-text-fill: #b00;"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="520.0" prefWidth="820.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.javafxdemo.chat.ChatController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #2b7de9; -fx-padding: 10;">
            <Label fx:id="meLabel"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="6">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Online Users"
                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
            <ListView fx:id="userList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="6">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="chatWithLabel" text="Select a user to chat"
                   style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
            <ListView fx:id="messageList" VBox.vgrow="ALWAYS"/>
            <HBox spacing="6">
                <TextField fx:id="inputField" promptText="Type a message..."
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" text="Send" defaultButton="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
